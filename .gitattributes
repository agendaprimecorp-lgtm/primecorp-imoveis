# Fim de linha: o repositorio guarda tudo em LF.
* text=auto

# Arquivos executados em Linux/conteiner: LF tambem no disco, sempre.
# Com CRLF o shebang vira "/bin/bash\r" e o script quebra com
# "bad interpreter". O mesmo vale para Dockerfile e configuracao do nginx.
*.sh                text eol=lf
*.py                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.sql               text eol=lf
*.conf              text eol=lf
Dockerfile          text eol=lf
.env.example        text eol=lf
nginx/**            text eol=lf

# Binarios: nunca converter.
*.png               binary
*.jpg               binary
*.pdf               binary
