# Gere cada segredo com: python -c "import secrets;print(secrets.token_urlsafe(48))"
# A aplicação RECUSA iniciar com valores de exemplo, curtos ou ausentes.
AMBIENTE=producao
APP_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://primecorp:SENHA@db:5432/primecorp?sslmode=prefer

COOKIE_SECURE=1
SESSION_HORAS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_PER_IP=20
